@page "/"
@inject Expense.Web.Services.ApiClient ApiClient

<PageHeader Title="Dashboard" Subtitle="KPI overview for Expense Tracker" />

@if (_loading)
{
    <MudSkeleton Height="120px" Width="100%" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><StatCard Title="Total" Value="@_items.Count.ToString()" Icon="@Icons.Material.Filled.Assessment" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><StatCard Title="Today" Value="@_items.Count(x => x.CreatedAtUtc.Date == DateTime.UtcNow.Date).ToString()" Icon="@Icons.Material.Filled.Today" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><StatCard Title="This Week" Value="@_items.Count(x => x.CreatedAtUtc > DateTime.UtcNow.AddDays(-7)).ToString()" Icon="@Icons.Material.Filled.DateRange" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><StatCard Title="Status" Value="Healthy" Icon="@Icons.Material.Filled.CheckCircle" /></MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Activity chart</MudText>
        <MudChart ChartType="ChartType.Line" Labels="_chartLabels" Data="_chartData" Width="100%" Height="300px" />
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<ListItemModel> _items = [];
    private string[] _chartLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private double[][] _chartData = [[1, 2, 3, 2, 4, 3, 5]];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await ApiClient.GetItemsAsync();
            var grouped = Enumerable.Range(0, 7)
                .Select(offset => DateTime.UtcNow.Date.AddDays(-6 + offset))
                .Select(day => (double)_items.Count(x => x.CreatedAtUtc.Date == day))
                .ToArray();
            _chartData = [grouped];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
