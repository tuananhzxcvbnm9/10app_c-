@page "/login"

<MudGrid Justify="Justify.Center" Class="mt-8">
    <MudItem xs="12" sm="10" md="6" lg="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5">Welcome back</MudText>
            <MudText Color="Color.Secondary" Class="mb-4">Sign in to continue</MudText>
            <MudTextField Label="Email" Variant="Variant.Outlined" FullWidth="true" />
            <MudTextField Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Login</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>
